{
  "name": "billy-quotes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm build && pnpm --filter @billy/worker dev",
    "db:migrate:local": "pnpm --filter @billy/worker db:migrate:local",
    "deploy:stage": "pnpm build && pnpm --filter @billy/worker deploy:stage",
    "deploy:production": "pnpm build && pnpm --filter @billy/worker deploy:production"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}

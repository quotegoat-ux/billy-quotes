{
  "name": "@billy/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "deploy:stage": "wrangler deploy --env stage",
    "deploy:production": "wrangler deploy --env production",
    "db:migrate:stage": "wrangler d1 migrations apply billy-quotes-db-stage --remote --env stage",
    "db:migrate:production": "wrangler d1 migrations apply billy-quotes-db --remote --env production"
  },
  "dependencies": {
    "@billy/core": "workspace:*",
    "@billy/quote-card": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.148.0"
  }
}
